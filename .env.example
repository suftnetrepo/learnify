# ── Database ──────────────────────────────────────────────────────────────────
# Use the POOLED connection URL from Neon for production/staging
# Use the DIRECT connection URL for running migrations (yarn db:push)
DATABASE_URL="postgresql://user:password@host:5432/learnify?sslmode=require"

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-here"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ── Stripe ────────────────────────────────────────────────────────────────────
# Use sk_test_ for development and staging
# Use sk_live_ for production only
# Note: Stripe checkout uses server-side redirect (no client-side Stripe.js needed)
STRIPE_SECRET_KEY="sk_test_your_key_here"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret_here"
STRIPE_PLATFORM_FEE_PERCENT="20"

# ── Cloudinary ────────────────────────────────────────────────────────────────
# Note: Cloudinary uploads are signed server-side (no public cloud name needed client-side)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# ── Email (Brevo) ─────────────────────────────────────────────────────────────
BREVO_API_KEY="xkeysib_your_key_here"
BREVO_FROM_EMAIL="noreply@suftnet.com"
BREVO_FROM_NAME="Edquis"
ADMIN_EMAIL="admin@yourdomain.com"
# Protects the queued-email retry endpoint at /api/cron/email
CRON_SECRET="generate-a-long-random-secret"

# ── reCAPTCHA v3 ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_RECAPTCHA_SITE_KEY="6Lc_your_site_key_here"
RECAPTCHA_SECRET_KEY="6Lc_your_secret_key_here"

# ── Sentry ────────────────────────────────────────────────────────────────────
# Leave empty to keep Sentry off. NEXT_PUBLIC_ is inlined at build time — set it before building.
SENTRY_DSN="https://your_key@your_org.ingest.sentry.io/your_project_id"
NEXT_PUBLIC_SENTRY_DSN="https://your_key@your_org.ingest.sentry.io/your_project_id"
SENTRY_AUTH_TOKEN="sntrys_your_token_here"
SENTRY_ORG="your_org_slug"
SENTRY_PROJECT="learnify-web"
# Set to "staging" on Render, "production" on Vercel
# Allows Sentry to separate staging errors from production errors
SENTRY_ENVIRONMENT="development"

# ── Render / Railway (staging) ────────────────────────────────────────────────
# Set to "staging" on Render to enable serverless DB pooling (max:1)
# RAILWAY_ENVIRONMENT="staging"

# ── Feature flags ─────────────────────────────────────────────────────────────
# Set to "true" to enable manager-level tutor access (course creation + pricing)
ENABLE_TUTOR_MANAGER="false"

# StudyMind AI integration — server side only (never NEXT_PUBLIC_)
STUDYMIND_API_KEY=sm_live_your_key_here
STUDYMIND_API_URL=https://api.aismartlearner.com

# ── Whiteboards (Excalidraw) ─────────────────────────────────────────────────
WHITEBOARD_MAX_SCENE_BYTES=10485760   # 10 MB
NEXT_PUBLIC_WHITEBOARD_AUTOSAVE_MS=1500

# ── Live whiteboard classrooms (Socket.IO, served by server.ts) ──────────────
# Shared by the Next.js app (signs join tokens) and the realtime server (verifies them).
# Generate with: openssl rand -base64 32
WHITEBOARD_JWT_SECRET=changeme
# Socket.IO runs inside the Next.js process (server.ts), on the same port as the app.
# In production, set this to your app's own URL (same host as Next.js)
# e.g. https://your-app.onrender.com — read at build time (also added to the CSP connect-src)
NEXT_PUBLIC_REALTIME_URL=http://localhost:3000
# Browser origins allowed to connect (comma-separated). Only matters for cross-origin
# clients — same-origin connections from the app itself don't need it.
REALTIME_CORS_ORIGIN=http://localhost:3000
