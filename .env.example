# ── Database ──────────────────────────────────────────────────────────────────
# Use the POOLED connection URL from Neon for production/staging
# Use the DIRECT connection URL for running migrations (yarn db:push)
DATABASE_URL="postgresql://user:password@host:5432/learnify?sslmode=require"

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-here"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ── Stripe ────────────────────────────────────────────────────────────────────
# Use sk_test_ / pk_test_ for development and staging
# Use sk_live_ / pk_live_ for production only
STRIPE_SECRET_KEY="sk_test_your_key_here"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_key_here"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret_here"
STRIPE_PLATFORM_FEE_PERCENT="20"

# ── Cloudinary ────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloud_name"

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY="re_your_key_here"
EMAIL_FROM="noreply@yourdomain.com"
ADMIN_EMAIL="admin@yourdomain.com"

# ── reCAPTCHA v3 ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_RECAPTCHA_SITE_KEY="6Lc_your_site_key_here"
RECAPTCHA_SECRET_KEY="6Lc_your_secret_key_here"

# ── Sentry ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN="https://your_key@your_org.ingest.sentry.io/your_project_id"
SENTRY_AUTH_TOKEN="sntrys_your_token_here"
SENTRY_ORG="your_org_slug"
SENTRY_PROJECT="learnify-web"
SENTRY_ENVIRONMENT="development"

# ── Render / Railway (staging) ────────────────────────────────────────────────
# Set to "staging" on Render to enable serverless DB pooling (max:1)
# RAILWAY_ENVIRONMENT="staging"

# ── Feature flags ─────────────────────────────────────────────────────────────
# Set to "true" to enable manager-level tutor access (course creation + pricing)
ENABLE_TUTOR_MANAGER="false"
