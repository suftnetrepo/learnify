# ── Database ──────────────────────────────────────────────────────────────────
# Use the POOLED connection URL from Neon for production/staging
# Use the DIRECT connection URL for running migrations (yarn db:push)
DATABASE_URL="postgresql://user:password@host:5432/learnify?sslmode=require"

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-here"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ── Stripe ────────────────────────────────────────────────────────────────────
# Use sk_test_ for development and staging
# Use sk_live_ for production only
# Note: Stripe checkout uses server-side redirect (no client-side Stripe.js needed)
STRIPE_SECRET_KEY="sk_test_your_key_here"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret_here"
STRIPE_PLATFORM_FEE_PERCENT="20"

# ── Cloudinary ────────────────────────────────────────────────────────────────
# Note: Cloudinary uploads are signed server-side (no public cloud name needed client-side)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# ── Email (Brevo) ─────────────────────────────────────────────────────────────
BREVO_API_KEY="xkeysib_your_key_here"
BREVO_FROM_EMAIL="noreply@suftnet.com"
BREVO_FROM_NAME="Edquis"
ADMIN_EMAIL="admin@yourdomain.com"
# Protects the queued-email retry endpoint at /api/cron/email
CRON_SECRET="generate-a-long-random-secret"

# ── reCAPTCHA v3 ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_RECAPTCHA_SITE_KEY="6Lc_your_site_key_here"
RECAPTCHA_SECRET_KEY="6Lc_your_secret_key_here"

# ── Sentry ────────────────────────────────────────────────────────────────────
# Leave empty to keep Sentry off. NEXT_PUBLIC_ is inlined at build time — set it before building.
SENTRY_DSN="https://your_key@your_org.ingest.sentry.io/your_project_id"
NEXT_PUBLIC_SENTRY_DSN="https://your_key@your_org.ingest.sentry.io/your_project_id"
SENTRY_AUTH_TOKEN="sntrys_your_token_here"
SENTRY_ORG="your_org_slug"
SENTRY_PROJECT="learnify-web"
# Set to "staging" on Render, "production" on Vercel
# Allows Sentry to separate staging errors from production errors
SENTRY_ENVIRONMENT="development"

# ── Render / Railway (staging) ────────────────────────────────────────────────
# Set to "staging" on Render to enable serverless DB pooling (max:1)
# RAILWAY_ENVIRONMENT="staging"

# ── Feature flags ─────────────────────────────────────────────────────────────
# Set to "true" to enable manager-level tutor access (course creation + pricing)
ENABLE_TUTOR_MANAGER="false"

# StudyMind AI integration — server side only (never NEXT_PUBLIC_)
STUDYMIND_API_KEY=sm_live_your_key_here
STUDYMIND_API_URL=https://api.aismartlearner.com

# ── Tranquis web subscriptions ────────────────────────────────────────────────
# Create recurring subscription products in the Stripe Dashboard (GBP) then
# paste the resulting price IDs here.
TRANQUIS_STRIPE_WEEKLY_PRICE_ID=price_xxx
TRANQUIS_STRIPE_MONTHLY_PRICE_ID=price_xxx
TRANQUIS_STRIPE_QUARTERLY_PRICE_ID=price_xxx
TRANQUIS_STRIPE_ANNUAL_PRICE_ID=price_xxx
# Deep-link scheme used on the success page to return users to the mobile app
TRANQUIS_APP_SCHEME=tranquis
# Base URL of the careermind-backend — Tranquis Stripe webhooks are forwarded here
CAREERMIND_API_URL=https://your-careermind-api.com

# ─── AI Tutor Pass (free courses) ────────────────────────────────────────────
# Keep "false" until launch is approved. Off = free courses behave exactly as before.
ENABLE_AI_TUTOR_PASS="false"
# Dedicated one-time £9.99 GBP Price (test-mode price in development). Checkout is
# refused (503) while unset; fulfilment re-checks the amount and currency server-side.
STRIPE_AI_PASS_PRICE_ID=
# Webhook must also receive: charge.refunded, charge.dispute.closed (in addition to the
# existing checkout.* / payment_intent.payment_failed / charge.dispute.created events).
# Schedule GET /api/cron/ai-pass-revocations (Bearer CRON_SECRET) every ~10 minutes to
# retry StudyMind policy revocations that failed inline.
