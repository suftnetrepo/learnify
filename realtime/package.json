{
  "name": "edquis-realtime",
  "version": "0.1.0",
  "private": true,
  "description": "Socket.IO server for live whiteboard classrooms — deployed separately from the Next.js app",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --env-file=.env --require ts-node/register src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "socket.io": "^4.8.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
