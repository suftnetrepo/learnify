# Same Postgres database as the Next.js app
DATABASE_URL=postgresql://user:password@localhost:5432/learnify
# Must match WHITEBOARD_JWT_SECRET in the Next.js app (openssl rand -base64 32)
WHITEBOARD_JWT_SECRET=changeme
# Browser origins allowed to connect (comma-separated) — the Next.js app's URL
REALTIME_CORS_ORIGIN=http://localhost:3000
REALTIME_PORT=4000
